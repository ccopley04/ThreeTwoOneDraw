      objectReference: {fileID: 2138394137}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: enterPrompt
      value: 
      objectReference: {fileID: 1968154030}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 376104248}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: interactPrompt
      value: 
      objectReference: {fileID: 874100492}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: enemySelectLine
      value: -1
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: lines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: weaponSelectLine
      value: -1
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: 'lines.Array.data[0]'
      value: Howdy pardner!
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: "Now, I\u2019ll say that was some fine dueling! I think you\u2019ve
        got what I am lookin for. "
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: "You don\u2019t really look the type to go diggin for gold ya self.
        So how about you do somethin for me Mr. Gunslinger. "
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: Ya see, down in my Mine there are some outlaws that have made themselves
        mighty comfy. As you could imagine, I find myself quite annoyed
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: 'lines.Array.data[4]'
      value: "With them cloggin up the Mine I can\u2019t even live up to my name!"
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: 'lines.Array.data[5]'
      value: "Folk start callin me, by my name again\u2026 I cannot abide that shame. "
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: 'lines.Array.data[6]'
      value: 'So whatcha say, mister? Clear the outlaws from my Mine in exchange
        for gold? '
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: 'lines.Array.data[7]'
      value: Welp, maybe in the full game! HA
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
      propertyPath: 'lines.Array.data[8]'
      value: "You don\u2019t really look the type to go diggin for gold ya self.
        So how about you do somethin for me Mr. Gunslinger. "
      objectReference: {fileID: 0}
    - target: {fileID: 2221923227978894502, guid: 59e5f3de743bdc3429fc157dcb688861, type: 3}
