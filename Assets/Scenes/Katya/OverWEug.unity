MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 920054739}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2b3c530596e0da24eb334944278f8e57, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueBox: {fileID: 2138394137}
  portrait: {fileID: 427982317}
  speakerName: {fileID: 85005342}
  dialogueText: {fileID: 376104248}
  interactPrompt: {fileID: 874100492}
  enterPrompt: {fileID: 1968154030}
  player: {fileID: 1987500909}
  tutorialNPC: 0
  dialogueButtons: {fileID: 1656981178}
  lines:
  - speakerId: bartender
    text: Howdy, Bill! Let me guess. The usual?
    quit: 0
  - speakerId: bill
    text: You got it.
    quit: 0
  - speakerId: bartender
    text: "I\u2019ll get that right out to ya!"
    quit: 0
  - speakerId: bill
    text: "\u2026You ever think about changing your past?\r\n"
    quit: 0
  - speakerId: bartender
    text: "I don\u2019t follow."
    quit: 0
  - speakerId: bill
    text: ' Fixing your old mistakes, wronging your rights. You ever think about
      that?'
    quit: 0
  - speakerId: bartender
    text: Hmm.
    quit: 0
  - speakerId: bartender
    text: "Not really. I\u2019ve been working here as long as I can remember. There\u2019s
      not much for me to fix. But that\u2019s alright with me!"
    quit: 0
  - speakerId: bill
    text: "\u2026Well, I have been. A lot. But I think it\u2019s time I stop thinking
      and start fixing. I\u2019m gonna be headin\u2019 out of town for a while.\r"
    quit: 0
  - speakerId: bartender
    text: "That\u2019s a shame. You think you\u2019re gonna come back?\r"
    quit: 0
  - speakerId: bill
    text: "I intend to.\r"
    quit: 0
  - speakerId: bartender
    text: "Well, I'll be right here when ya get back!\r"
    quit: 1
  - speakerId: bill
    text: "I'm not sure.\r"
    quit: 0
  - speakerId: bartender
    text: "Darn...\r"
    quit: 0
  - speakerId: bill
    text: " I wanted to tell you thanks for being by my side for so long here. You\u2019ve
      been a great pal. "
    quit: 0
  - speakerId: bartender
    text: "Now, don\u2019t make me cry, Bill!"
    quit: 1
  lines2: []
  images: []
  tutorialImage: {fileID: 0}
  lineNum: 0
